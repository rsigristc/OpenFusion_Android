+    public void fusionFallSendMouseButton(boolean down) {
+        if (xServer == null) return;
+        if (down) {
+            // ATK is an Android overlay, not an X11 coordinate. Always begin the
+            // guest click in the safe center of the client surface so a stale hidden
+            // pointer can never press a Wine window border/title and start resizing.
+            xServer.injectPointerMove(xServer.screenInfo.width / 2, xServer.screenInfo.height / 2);
+            xServer.injectPointerButtonPress(com.winlator.xserver.Pointer.Button.BUTTON_LEFT);
+        }
+        else xServer.injectPointerButtonRelease(com.winlator.xserver.Pointer.Button.BUTTON_LEFT);
+    }
+
+    @androidx.annotation.Keep
+    public void fusionFallSendAttackAim(int dx, int dy) {
+        if (xServer == null || (dx == 0 && dy == 0)) return;
+        // Keep aim motion on Wine's relative input channel. injectPointerMoveDelta()
+        // would move the X11 pointer while BUTTON_LEFT is held and can resize/move
+        // the guest window when that hidden pointer reaches a decorated edge.
+        xServer.getWinHandler().mouseEvent(com.winlator.winhandler.MouseEventFlags.MOVE, dx, dy, 0);
+    }
+
+    @androidx.annotation.Keep
+    public void fusionFallSendRelativeMouse(int dx, int dy) {
+        if (xServer == null || (dx == 0 && dy == 0)) return;
+        if (xServer.isRelativeMouseMovement()) {
+            xServer.getWinHandler().mouseEvent(com.winlator.winhandler.MouseEventFlags.MOVE, dx, dy, 0);
+        }
+        else xServer.injectPointerMoveDelta(dx, dy);
+    }
+
